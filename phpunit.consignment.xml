<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="ConsignmentBaseline">
            <directory suffix="Test.php">./Modules/Consignment/Tests</directory>
            <file>./Modules/Adjustment/Tests/Feature/BaselineTokenFingerprintBindingTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/BreakageProductTableTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/CountDraftSchemaVersionTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationAdjustmentProductTableTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationApprovalTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationDraftPersistenceTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationLifecycleTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationReconciliationTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationSerialClassificationTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/MultiLocationShowViewTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/SelectedLocationPoolResolverTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/StoreBreakageValidationTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/TransferEditSerializedDestinationRegressionTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/TransferV3BuyoutReservationTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/TransferV3DispatchReceiptCancellationTest.php</file>
            <file>./Modules/Adjustment/Tests/Feature/TransferV3GoodsAndNumberingTest.php</file>
            <file>./Modules/Pos/Tests/Feature/POSReturnAtomicLifecycleTest.php</file>
            <file>./Modules/Pos/Tests/Feature/POSReturnCrossOwnerReplacementTest.php</file>
            <file>./Modules/Product/Tests/Feature/ProductStockSerialConversionPoolValidationTest.php</file>
            <file>./Modules/Purchase/Tests/Feature/ConsignmentPurchaseAttachmentAndUiTest.php</file>
            <file>./Modules/Purchase/Tests/Feature/ConsignmentPurchaseDateAdjustmentTest.php</file>
            <file>./Modules/Purchase/Tests/Feature/ConsignmentPurchaseInlineEditorTest.php</file>
            <file>./Modules/Purchase/Tests/Feature/GlobalPurchasePaymentStoreTest.php</file>
            <file>./Modules/Purchase/Tests/Feature/PurchaseLazyLoadingPreventionTest.php</file>
            <file>./Modules/Purchase/Tests/Feature/PurchaseShowConsignmentProvenanceTest.php</file>
            <file>./Modules/Purchase/Tests/Unit/PurchasePaymentStoreServiceTest.php</file>
            <file>./Modules/Sale/Tests/Feature/SalesImportProductSplitNoStockTest.php</file>
            <file>./Modules/Setting/Tests/Feature/MultiLocationSearchDropdownTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameApprovalTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameBuyoutClaimTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameLifecycleFoundationTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameReconciliationServiceTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameRedesignTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameShowViewCorrectionsTest.php</file>
            <file>./tests/Feature/Adjustment/StockOpnameSubmissionDecisionLifecycleTest.php</file>
            <file>./tests/Feature/Adjustment/SyncNotificationsAdjustmentTest.php</file>
            <file>./tests/Feature/Livewire/Purchase/SearchProductSelectionRoutingTest.php</file>
            <file>./tests/Feature/MasterDataDeactivationTest.php</file>
            <file>./tests/Feature/Concerns/PreservesMigrationSeededTablesTest.php</file>
        </testsuite>
    </testsuites>
    <groups>
        <exclude>
            <!-- Need the isolated MySQL database (phpunit.mysql.xml / scripts/run-mysql-sequence-tests.sh).
                 Their DatabaseTruncation setUp() wipes seeded tables on the shared SQLite database
                 before they can skip, so they must not be loaded in the default run. -->
            <group>mysql</group>
        </exclude>
    </groups>
    <coverage>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="CACHE_DRIVER" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="SCOUT_DRIVER" value="null"/>
        <server name="algolia_app_id" value="null"/>
        <server name="algolia_secret" value="null"/>
        <server name="SEQUENCE_PURCHASE_ENABLED" value="true"/>
        <server name="SEQUENCE_SALE_ENABLED" value="true"/>
    </php>
</phpunit>
